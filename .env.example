# Copy this file to .env.local with:
#   PowerShell: ./scripts/setup-env.ps1
#   Bash:       bash scripts/setup-env.sh
#
# Never commit .env.local.

GIN_MODE=debug
PORT=8080
PUBLIC_BASE_URL=http://goshorty.localhost:8080
ALLOWED_ORIGINS=http://goshorty.localhost:8080,http://127.0.0.1:8080,http://localhost:8080
TRUSTED_PROXIES=127.0.0.1,::1
TOKEN_TTL=24h
METRICS_TOKEN=
# Per-IP registration budget per hour. Default 5 keeps production spam-safe;
# raise it (e.g. 50) for test/CI suites that register repeatedly.
REGISTER_LIMIT_PER_HOUR=5

# Optional token hardening (see SECURITY.md). Empty issuer/audience means "not
# enforced" (existing tokens keep working). Enabling them invalidates tokens
# issued before the change. SECRET_KEY_PREVIOUS enables smooth key rotation.
TOKEN_ISSUER=
TOKEN_AUDIENCE=
# SECRET_KEY_PREVIOUS=

# setup-env replaces this placeholder with a random local signing key.
SECRET_KEY=GENERATE_ME

# Local development credentials only. Do not reuse in any shared environment.
ADMIN_PASSWORD=local-admin-password-change-me
ADMIN_EMAIL=admin@local.test

# PostgreSQL settings consumed by compose.yaml.
POSTGRES_USER=goshorty
POSTGRES_PASSWORD=goshorty-local-password
POSTGRES_DB=goshorty
POSTGRES_PORT=5432

# Application and integration-test connections.
DATABASE_URL=postgres://goshorty:goshorty-local-password@127.0.0.1:5432/goshorty?sslmode=disable
TEST_DATABASE_URL=postgres://goshorty:goshorty-local-password@127.0.0.1:5432/goshorty?sslmode=disable

# Optional embedded PostgreSQL, used only when Docker is unavailable:
#   EMBEDDED_PG=1       runs the storage integration tests against an embedded
#                       server (scripts/dev and scripts/test-local set it when
#                       no Docker engine is detected)
#   EMBEDDED_PG_PORT    embedded test server port (default 15432)
#   LOCALDB_PORT        cmd/localdb dev server port (default 5433)
# EMBEDDED_PG=0
# EMBEDDED_PG_PORT=15432
# LOCALDB_PORT=5433
