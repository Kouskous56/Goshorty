# Copy this file to .env.local with:
#   PowerShell: ./scripts/setup-env.ps1
#   Bash:       bash scripts/setup-env.sh
#
# Never commit .env.local.

GIN_MODE=debug
PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
TRUSTED_PROXIES=127.0.0.1,::1
TOKEN_TTL=24h
METRICS_TOKEN=

# setup-env replaces this placeholder with a random local signing key.
SECRET_KEY=GENERATE_ME

# Local development credentials only. Do not reuse in any shared environment.
ADMIN_PASSWORD=local-admin-password-change-me
ADMIN_EMAIL=admin@local.test

# PostgreSQL settings consumed by compose.yaml.
POSTGRES_USER=goshorty
POSTGRES_PASSWORD=goshorty-local-password
POSTGRES_DB=goshorty
POSTGRES_PORT=5432

# Application and integration-test connections.
DATABASE_URL=postgres://goshorty:goshorty-local-password@127.0.0.1:5432/goshorty?sslmode=disable
TEST_DATABASE_URL=postgres://goshorty:goshorty-local-password@127.0.0.1:5432/goshorty?sslmode=disable
