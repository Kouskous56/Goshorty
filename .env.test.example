GIN_MODE=release
PORT=18080
PUBLIC_BASE_URL=http://127.0.0.1:18080
ALLOWED_ORIGINS=http://127.0.0.1:18080
TRUSTED_PROXIES=127.0.0.1,::1
TOKEN_TTL=15m
METRICS_TOKEN=test-only-metrics-token-with-32-bytes
# Headroom for repeated E2E registrations; production keeps the default 5.
REGISTER_LIMIT_PER_HOUR=50

# Test-only values. They must never be reused in production.
SECRET_KEY=test-only-signing-key-that-is-long-and-deterministic
ADMIN_PASSWORD=test-admin-password-change-me
ADMIN_EMAIL=admin@test.local

DATABASE_URL=postgres://goshorty:goshorty-local-password@127.0.0.1:5432/goshorty?sslmode=disable
TEST_DATABASE_URL=postgres://goshorty:goshorty-local-password@127.0.0.1:5432/goshorty?sslmode=disable
