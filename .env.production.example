# Railway production template. Store real values in Railway Variables, never in
# this repository.
GIN_MODE=release
PUBLIC_BASE_URL=https://your-production-domain.example
ALLOWED_ORIGINS=https://your-production-domain.example
TRUSTED_PROXIES=100.64.0.0/10
TOKEN_TTL=24h
METRICS_TOKEN=REPLACE_WITH_A_UNIQUE_32_BYTE_OPERATIONAL_TOKEN
# Per-IP registration budget per hour (default 5). Raise only if a legitimate
# rollout needs it; the fixed-window counter lives in process memory.
REGISTER_LIMIT_PER_HOUR=5
# Go runtime profiling (/debug/pprof/*) is OFF by default and should stay off
# on publicly reachable deployments (see OPERATIONS.md "Profiling (pprof)").
PPROF_ENABLED=false

# Optional token hardening. Empty = not enforced (existing tokens keep
# working). Enabling TOKEN_ISSUER/TOKEN_AUDIENCE invalidates tokens issued
# before the deploy (clients must sign in again). SECRET_KEY_PREVIOUS enables
# smooth rotation: old tokens keep verifying until the value is removed
# (see OPERATIONS.md "Incident and secret rotation").
TOKEN_ISSUER=
TOKEN_AUDIENCE=
# SECRET_KEY_PREVIOUS=

SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_12_TO_72_BYTE_PASSWORD
ADMIN_EMAIL=admin@your-domain.example

# In Railway, use a same-project service reference:
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Railway supplies PORT automatically.
